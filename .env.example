DB_NAME=spring_boot_3_kotlin_demo_corouter
DB_USERNAME=postgres
DB_PASSWORD=
DB_PORT=5432
SERVER_PORT=8087
# HS256 key, at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me

# Local-only features. All default to off/production values when unset.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
SWAGGER_ENABLED=true
DEV_TOKEN_ENABLED=true
SERVER_ADDRESS=127.0.0.1
JWT_TTL=1h
